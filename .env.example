# Copy to .env and fill locally. Never commit .env.
# Dedicated server / client
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=7777
GAME_PROTOCOL_VERSION=1

# Cloudflare Pages (CI secrets are set in GitHub, not here)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=tactical-voxel-shooter

# Build pins (fill after G0; see docs/GATES.md)
GODOT_VERSION=4.7.2-stable
GODOT_COMMIT=ed1daf0bf
VOXEL_TOOLS_VERSION=1.7
VOXEL_TOOLS_COMMIT=TBD  # resolve from https://github.com/Zylann/godot_voxel/releases (v1.7x GDExtension)
EMSDK_VERSION=4.0.20
GODOTCPP_BRANCH=4.7
