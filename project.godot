; Engine configuration file.
; Godot 4.7.2. Single project: client and headless server share the same codebase.
; Server mode is planned as: godot --headless -- --server

config_version=5

[application]

config/name="Tactical Voxel Shooter"
config/description="Web-first tactical voxel shooter (Phase 0 spike)."
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
