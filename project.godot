; Engine configuration file.
; Godot 4.7.2. Single project: client and headless server share the same codebase.
; Server mode is planned as: godot --headless -- --server

config_version=5

[application]

config/name="Tactical Voxel Shooter"
config/description="Web-first tactical voxel shooter (Phase 0 spike)."
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
rendering/2d/snap/snap_2d_transforms_to_pixel=true
rendering/2d/snap/snap_2d_vertices_to_pixel=true
rendering/anti_aliasing/quality/msaa_3d=0
rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
renderer/rendering_method.mobile="gl_compatibility"
